# ============================================
# Sacred Core — Environment Configuration
# ============================================

# --- REQUIRED: Supabase (Auth + Database) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- REQUIRED: Google Gemini API ---
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# --- REQUIRED: Stripe (Payments) ---
# Frontend (publishable key)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-key-here
# Backend (secret key — server.ts only, NOT prefixed with VITE_)
STRIPE_SECRET_KEY=sk_test_your-key-here
# Stripe Price IDs (create in Stripe Dashboard)
STRIPE_PRICE_PRO_MONTHLY=price_xxxxx
STRIPE_PRICE_PRO_ANNUAL=price_xxxxx
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_xxxxx
STRIPE_PRICE_ENTERPRISE_ANNUAL=price_xxxxx

# --- OPTIONAL: Firebase (if using Firebase instead of Supabase) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=

# --- OPTIONAL: Additional LLM Providers ---
VITE_OPENAI_API_KEY=
VITE_ANTHROPIC_API_KEY=

# --- OPTIONAL: Sentry (Error Tracking) ---
VITE_SENTRY_DSN=
VITE_SENTRY_ENABLED=true
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACE_SAMPLE_RATE=0.1

# --- Server Config ---
API_PORT=4000
API_HOST=0.0.0.0
JWT_SECRET=change-this-to-a-random-secret
CORS_ORIGIN=http://localhost:3001,http://localhost:3000
APP_URL=http://localhost:3001

# --- App Metadata ---
VITE_APP_NAME=Sacred Core
VITE_APP_VERSION=1.0.0
VITE_LOG_LEVEL=info
